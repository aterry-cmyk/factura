# Postgres (Supabase: Project Settings → Database → connection string, "Transaction" pooler on port 6543 works)
DATABASE_URL=postgres://user:password@host:5432/postgres

# The one sign-in. SESSION_SECRET: 32+ random characters (openssl rand -hex 32)
OWNER_PASSWORD=
SESSION_SECRET=

# The assistant (Claude). Optional override: ANTHROPIC_MODEL
ANTHROPIC_API_KEY=

# Address printed in links sent to customers, e.g. https://facturas.example.com
APP_URL=

# Email through Resend (verify your domain there first)
RESEND_API_KEY=
EMAIL_FROM=Facturas <facturas@example.com>

# Text messages through Twilio (a number that can send SMS in the US; needs A2P 10DLC registration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550123

# Vercel Cron sends this as a Bearer token to /api/cron/reminders
CRON_SECRET=
